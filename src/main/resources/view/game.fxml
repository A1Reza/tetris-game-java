<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GameController"
            onKeyPressed="#sceneKeyListeners"
            focusTraversable="true">

    <center>
        <HBox spacing="14" style="-fx-padding: 10;">
            <!-- Stacked board: fixed grid (bottom) + falling piece overlay (top) -->
            <StackPane>
                <Pane fx:id="gamePane" prefWidth="300" prefHeight="400"/>
                <Pane fx:id="paneFalling" prefWidth="300" prefHeight="400"
                      mouseTransparent="true"/>
            </StackPane>

            <!-- Right sidebar -->
            <VBox spacing="10" alignment="TOP_CENTER">
                <Label fx:id="lblScore" text="Score: 0"/>
                <Label fx:id="lblHeart" text="Heart: 3"/>
                <Label fx:id="lblLevel" text="level: 1"/>

                <Label text="Next:"/>

                <Pane fx:id="paneNextBrick" prefWidth="80" prefHeight="80"
                      style="-fx-background-color: rgba(0,0,0,0.15);
                             -fx-border-color: #888;
                             -fx-border-width: 1;"/>

                <Button fx:id="btnStart" text="Start" focusTraversable="false"/>
                <Button fx:id="btnBack" text="Back" focusTraversable="false"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>