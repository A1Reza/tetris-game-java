<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="pane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.MainMenuController">
  <padding><Insets top="28" right="40" bottom="25" left="40"/></padding>
  <top><HBox alignment="CENTER_LEFT"><Label text="tetris." styleClass="wordmark"/><Region HBox.hgrow="ALWAYS"/><Label text="A CLASSIC, REIMAGINED." styleClass="eyebrow"/></HBox></top>
  <center><VBox alignment="CENTER" spacing="13">
    <Label text="SMALL GAME. BIG FLOW." styleClass="eyebrow"/>
    <Label text="One more line." styleClass="hero-title"/>
    <Label text="A little focus. A few falling blocks. Find your rhythm." styleClass="subtitle"/>
    <Region prefHeight="16"/>
    <Button fx:id="btnNewGame" text="Let's play  →" styleClass="button,primary" prefWidth="210"/>
    <Button fx:id="btnScoresTable" text="Your high scores" prefWidth="210"/>
    <Button fx:id="btnSettings" text="Make it yours" prefWidth="210"/>
    <Button fx:id="btnExit" text="Exit" prefWidth="210"/>
  </VBox></center>
  <bottom><HBox><Label text="Built for the joy of it." styleClass="eyebrow"/><Region HBox.hgrow="ALWAYS"/><Label text="JAVA DESKTOP EDITION" styleClass="eyebrow"/></HBox></bottom>
</BorderPane>
