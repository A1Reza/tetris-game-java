<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.GameController" onKeyPressed="#sceneKeyListeners" focusTraversable="true">
  <padding><Insets top="22" right="32" bottom="24" left="32"/></padding>
  <top><VBox spacing="6"><Label text="One more line." styleClass="game-title"/><Label text="Clear lines. Make space. See how far you can go." styleClass="subtitle"/><Region prefHeight="20"/></VBox></top>
  <center><HBox alignment="TOP_CENTER" spacing="24">
    <StackPane maxHeight="400" maxWidth="300" minHeight="400" minWidth="300">
      <Pane fx:id="gamePane" prefWidth="300" prefHeight="400"/>
      <Pane fx:id="paneFalling" prefWidth="300" prefHeight="400" mouseTransparent="true"/>
    </StackPane>
    <VBox spacing="12" prefWidth="190">
      <VBox spacing="8" styleClass="card"><Label text="YOUR GAME" styleClass="eyebrow"/><Label fx:id="lblScore" text="Score: 0" styleClass="stat"/><HBox spacing="16"><Label fx:id="lblLevel" text="Level: 1"/><Label fx:id="lblHeart" text="Lives: 3"/></HBox></VBox>
      <VBox spacing="10" styleClass="card"><Label text="UP NEXT" styleClass="eyebrow"/><Pane fx:id="paneNextBrick" prefWidth="100" prefHeight="76" styleClass="preview"/></VBox>
      <Button fx:id="btnStart" text="Start" styleClass="button,primary" maxWidth="Infinity" focusTraversable="false"/>
      <Button fx:id="btnBack" text="←  Main menu" maxWidth="Infinity" focusTraversable="false"/>
      <Label text="← →  Move     ↑  Rotate&#10;↓  Soft drop    Z  Turn left&#10;Space / Enter  Hard drop&#10;P / Esc  Pause" styleClass="controls" wrapText="true"/>
    </VBox>
  </HBox></center>
  <bottom><Label text="A SMALL TIP     Keep your stack low and leave a little room to breathe." styleClass="eyebrow"/></bottom>
</BorderPane>
