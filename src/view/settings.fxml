<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane alignment="CENTER" hgap="5.0" prefHeight="230.0" prefWidth="354.0" vgap="5.0"
          xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="controller.SettingsManager">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
    </rowConstraints>
    <children>
        <Label text="Scores per row :" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
        <Label text="Background color:" GridPane.halignment="CENTER" GridPane.rowIndex="1"
               GridPane.valignment="CENTER"/>
        <Label text="Start level:" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER"/>
        <TextField fx:id="lblScorePerRow" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   minHeight="-Infinity" minWidth="-Infinity" prefWidth="100.0" text="10" GridPane.columnIndex="1"/>
        <Button fx:id="btnClearScore" mnemonicParsing="false" prefHeight="39.0" prefWidth="211.0" text="Clear Scores"
                GridPane.rowIndex="3">
            <GridPane.margin>
                <Insets left="20.0" right="20.0"/>
            </GridPane.margin>
        </Button>
        <TextField fx:id="lblStartLevel" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   minHeight="-Infinity" minWidth="-Infinity" prefWidth="100.0" text="1" GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>
        <ColorPicker fx:id="cpBgColor" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </children>
</GridPane>
